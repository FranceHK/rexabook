# =====================================================================
# RexaBook – environment example
# Copy to `.env` and fill in the values. NEVER commit `.env`.
# =====================================================================

# --- Database (Neon PostgreSQL) --------------------------------------
# Get a connection string from your Neon dashboard: Console > Connect.
# Use the pooled (prisma) connection string for production:
#   postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/DB?sslmode=require
DATABASE_URL=

# --- Session authentication -------------------------------------------
# A long random string used to sign session cookies.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Base URL of the app (used for cookies and redirects).
NEXTAUTH_URL=http://localhost:3000

# --- SMS (Meseji) – optional -------------------------------------------
# Meseji accepts either x-api-key or a Bearer token. The API key is the
# recommended server-to-server credential for this app.
MESEJI_API_KEY=
MESEJI_TOKEN=
MESEJI_SENDER=MESEJI

# --- SMS payments (Snippe) ---------------------------------------------
# Server-side credentials for direct mobile-money collection.
SNIPPE_API_KEY=
SNIPPE_WEBHOOK_SECRET=
# Public HTTPS callback. Leave empty to use NEXTAUTH_URL/api/webhooks/snippe.
SNIPPE_WEBHOOK_URL=

# --- MySQL source (only used by the migration script) ------------------
# Connection used by `npm run db:migrate-mysql` to pull the legacy data
# out of the old `htdocs` MySQL database.
MYSQL_HOST=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_PORT=3306
